# Local quick start: copy to .env. No credentials required for demo mode.
DATABASE_URL=sqlite:///./distributedrag.db
SEARCH_BACKEND=local
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=384
# Optional admin HTTP tenant creation. Generate at least 24 random characters.
ADMIN_KEY=

# Distributed mode: Docker Compose overrides these service addresses.
OPENSEARCH_URL=http://localhost:9200
INDEX_NAME=distributedrag-v1
INDEX_SHARDS=4
INDEX_REPLICAS=0
REDIS_URL=

# Set EMBEDDING_PROVIDER=openai for real semantic embeddings.
# The endpoint must implement POST /v1/embeddings with this model/dimension.
EMBEDDING_URL=http://localhost:8080/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional Groq-compatible answer generation; never sent to the browser.
LLM_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

CHUNK_WORDS=240
CHUNK_OVERLAP=40
LEASE_SECONDS=90
MAX_ATTEMPTS=5
MAX_PENDING_JOBS=10000
CACHE_TTL=60
RATE_LIMIT=120
